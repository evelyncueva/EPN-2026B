<question type="multichoice">
  <name format="html">
    <text><![CDATA[calculo-diferencial-MATD124-03]]></text>
  </name>
  <questiontext format="html">
    <text><![CDATA[<p>¿Cuál de las siguientes condiciones define que una sucesión real \((a_n)\) es de Cauchy? </p>]]></text>
  </questiontext>
  <defaultgrade>1.0</defaultgrade>
  <generalfeedback format="html"><text/></generalfeedback>
  <penalty>0.10</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>0</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>Para todo \(\varepsilon &gt;0\), existe \(N\in \mathbb {N}\) tal que \(|a_n-a_m|&lt;\varepsilon \) para todos \(n,m\geq N\).</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>Existe \(\varepsilon &gt;0\) tal que \(|a_n-a_m|&lt;\varepsilon \) para todos \(n,m\in \mathbb {N}\).</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>Para todo \(\varepsilon &gt;0\), existe \(N\in \mathbb {N}\) tal que \(|a_n|&lt;\varepsilon \) para todo \(n\geq N\).</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>Existe \(N\in \mathbb {N}\) tal que \(a_n=a_m\) para todos \(n,m\geq N\).</p>]]></text>
  </answer>
</question>
