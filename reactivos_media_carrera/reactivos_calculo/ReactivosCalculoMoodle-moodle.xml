<question type="multichoice">
  <name format="html">
    <text><![CDATA[calculo-diferencial-MATD124-09]]></text>
  </name>
  <questiontext format="html">
    <text><![CDATA[<p>Una función \(f\) es continua en \([0,3]\) y diferenciable en \((0,3)\). Se sabe que \(f'(x)&lt;0\) para \(0&lt;x&lt;1\) y que \(f'(x)&gt;0\) para \(1&lt;x&lt;3\). Sin conocer una fórmula para \(f\), ¿cuál de las siguientes afirmaciones es necesariamente verdadera? </p>]]></text>
  </questiontext>
  <defaultgrade>1.0</defaultgrade>
  <generalfeedback format="html"><text/></generalfeedback>
  <penalty>0.10</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>0</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(f\) alcanza su máximo absoluto en \(x=1\).</p>]]></text>
  </answer>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\(f\) alcanza su mínimo absoluto en \(x=1\).</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(f(0)&lt;f(1)\).</p>]]></text>
  </answer>
