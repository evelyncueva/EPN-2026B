<question type="multichoice">
  <name format="html">
    <text><![CDATA[calculo-diferencial-MATD124-01]]></text>
  </name>
  <questiontext format="html">
    <text><![CDATA[<p>Sea \(S=\{1-1/n:n\in \mathbb {N}\}\). ¿Cuál es la afirmación correcta? </p>]]></text>
  </questiontext>
  <defaultgrade>1.0</defaultgrade>
  <generalfeedback format="html"><text/></generalfeedback>
  <penalty>0.10</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>0</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\inf S=0\) y \(\max S=1\).</p>]]></text>
  </answer>
  <answer fraction="100" format="html">
    <text><![CDATA[<p>\(\min S=0\), \(\sup S=1\) y \(S\) no tiene máximo.</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\inf S=-1\) y \(\sup S=1\).</p>]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[<p>\(\min S=0\) y \(\sup S=0\).</p>]]></text>
  </answer>
</question>
