\newcommand{\tituloclase}[3]{%
  \begin{center}
  {\color{Azul}\Large\bfseries #1}\par
  \vspace{2pt}{\small #2}\par
  \vspace{4pt}\colorbox{Azul}{\color{white}\strut\quad #3\quad}
  \end{center}}

\newtcolorbox{objetivos}{breakable,colback=AzulClaro!65,colframe=Azul,title=Objetivos de aprendizaje,fonttitle=\bfseries,arc=2mm,boxrule=0.7pt}
\newtcolorbox{resumen}[1][]{breakable,colback=GrisClaro,colframe=Gris!70,title={Síntesis#1},fonttitle=\bfseries,arc=2mm,boxrule=0.5pt}
\newcommand{\titulonumerado}[3]{%
  #1~#2\if\relax\detokenize{#3}\relax\else: #3\fi}
\newtcolorbox[auto counter]{definicion}[1][]{breakable,colback=AzulClaro!55,colframe=Azul,title={\titulonumerado{Definición}{\thetcbcounter}{#1}},fonttitle=\bfseries,arc=2mm,boxrule=0.7pt}
\newtcolorbox[auto counter]{teorema}[1][]{breakable,colback=GrisClaro,colframe=Azul!75,title={\titulonumerado{Teorema}{\thetcbcounter}{#1}},fonttitle=\bfseries,arc=2mm,boxrule=0.6pt}
\newtcolorbox[auto counter]{proposicion}[1][]{breakable,colback=GrisClaro,colframe=Azul!75,title={\titulonumerado{Proposición o criterio}{\thetcbcounter}{#1}},fonttitle=\bfseries,arc=2mm,boxrule=0.6pt}
\newtcolorbox[auto counter]{ejemplo}[1][]{enhanced,breakable,blanker,borderline west={1pt}{0pt}{Gris!70},title={\titulonumerado{Ejemplo}{\thetcbcounter}{#1}},coltitle=Azul,fonttitle=\bfseries,left=3mm,right=0mm,top=1mm,bottom=1mm,before skip=5pt,after skip=5pt}
\newtcolorbox[auto counter]{ejercicios}[1][]{breakable,colback=GrisClaro,colframe=Azul,title={\titulonumerado{Ejercicios propuestos}{\thetcbcounter}{#1}},fonttitle=\bfseries,arc=2mm,boxrule=0.7pt}
\newcounter{solucion}
\newenvironment{solucion}[1][]{%
  \refstepcounter{solucion}%
  \par\medskip\noindent\textbf{\titulonumerado{Solución}{\thesolucion}{#1}.}\enspace\ignorespaces
}{%
  \par\medskip
}
