% --- Paquetes requeridos
\RequirePackage{tabularx}

\newcounter{proofstmt}
\newenvironment{Proof-Geo}{
  \renewcommand{\tabularxcolumn}[1]{>{\raggedright\arraybackslash}p{##1}}
  \renewcommand{\arraystretch}{1.15}
  \setcounter{proofstmt}{0}
  \newcommand{\Paso}[2]{%
    \refstepcounter{proofstmt}
    \theproofstmt. & $##1$ & \theproofstmt. & ##2\\
  }
  %\vspace{\baselineskip}
  \noindent\tabularx{0.95\textwidth}{c @{\hspace{0.5em}}X c@{\hspace{0.5em}} X}
  \hline
  \multicolumn{2}{c}{\bfseries Proposiciones} & \multicolumn{2}{c}{\bfseries Razones}\\
  \hline
}{%
  \hline
  \endtabularx%
  %\hrule
  %
  %\vspace*{\baselineskip}
}

